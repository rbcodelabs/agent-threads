# Copy to deploy/.env, chmod 600. Never commit the real file.
#
# Claude credential (`claude setup-token` prints a long-lived token). Or leave unset and sign in once inside the
# container:  docker compose exec -it agent-threads claude   (the login persists in the data volume).
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=
#
# GitHub, for pushes and pull requests from agent sessions (fine-grained, scoped to the repos you want).
#GH_TOKEN=
#
# Host port (loopback only).
#AGENT_THREADS_PORT=7433
