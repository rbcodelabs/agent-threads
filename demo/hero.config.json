{
  "title": "Agent Threads hero",
  "target": {
    "type": "electron",
    "app": "/home/rick/geode-gate",
    "env": {
      "GEODE_HEADLESS": "0",
      "GEODE_SCREENSHOT_MODE": "1",
      "CLAUDE_THREADS_DEMO_SCRIPT": "{{fixture}}/.geode/plugins/claude-threads/demo-script.json"
    },
    "readySelector": ".workspace-leaf-content[data-type=\"claude-threads:chat\"]",
    "readyTimeoutMs": 45000,
    "fixture": {
      "source": "demo/fixture-vault"
    },
    "userDataFiles": {
      "geode.json": {
        "recentVaults": [
          "{{fixture}}"
        ],
        "lastVault": "{{fixture}}"
      }
    }
  },
  "environment": {
    "record": {
      "runner": "ssh",
      "host": "dev-builder",
      "remoteDir": "~/product-demo-work",
      "shellInit": "export PATH=\"$HOME/.local/share/fnm:$PATH\"; eval \"$(fnm env)\"",
      "setup": [
        "test -f \"$HOME/geode-gate/dist/main.js\" || { echo \"no built Geode at $HOME/geode-gate (see demo/README.md)\" >&2; exit 1; }",
        "mkdir -p node_modules && ln -sfn \"$HOME/geode-gate/node_modules/electron\" node_modules/electron"
      ],
      "syncExclude": [
        "docs",
        "screenshots",
        "test",
        "src",
        "relay",
        "api",
        "sandbox",
        "dist",
        ".worktrees"
      ]
    }
  },
  "capture": {
    "width": 1280,
    "height": 800,
    "fps": 30
  },
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "look": {
    "windowWidth": 1440,
    "cornerRadius": 14,
    "dock": true,
    "menuBar": {
      "appName": "Geode",
      "items": [
        "File",
        "Edit",
        "View",
        "Go",
        "Window",
        "Help"
      ],
      "clock": "Sun Oct 11  9:41 AM"
    },
    "appIcon": "demo/assets/geode-icon.png"
  },
  "voice": {
    "provider": "none",
    "modelId": "x",
    "stability": 0.5,
    "similarityBoost": 0.75,
    "style": 0
  },
  "timing": {
    "leadMs": 200,
    "tailMs": 300,
    "maxSlowdown": 1.3
  },
  "scenes": [
    {
      "id": "ask",
      "narration": "Ask an agent for anything.",
      "actions": [
        {
          "type": "click",
          "selector": ".mod-right-split .workspace-tab-header[aria-label*=\"thread\"]"
        },
        {
          "type": "waitFor",
          "selector": ".ct-agents-row",
          "timeoutMs": 15000
        },
        {
          "type": "pause",
          "ms": 600
        },
        {
          "type": "click",
          "selector": "[aria-label=\"New thread\"]",
          "cue": "Ask an agent"
        },
        {
          "type": "click",
          "selector": ".menu-item:has-text(\"Fieldnotes Launch\")"
        },
        {
          "type": "type",
          "text": "Draft the release notes for the November launch",
          "delayMs": 16,
          "cue": "for anything"
        },
        {
          "type": "press",
          "key": "Enter"
        },
        {
          "type": "pause",
          "ms": 1200
        }
      ]
    },
    {
      "id": "work",
      "narration": "Watch it work, one tool call at a time.",
      "actions": [
        {
          "type": "hover",
          "selector": ".workspace-leaf-content[data-type=\"claude-threads:chat\"] .ct-tool-pill",
          "cue": "one tool call",
          "optional": true
        },
        {
          "type": "pause",
          "ms": 2800
        }
      ]
    },
    {
      "id": "subagents",
      "narration": "Sub-agents run in parallel, and you can follow each one.",
      "actions": [
        {
          "type": "waitFor",
          "selector": ".workspace-leaf-content[data-type=\"claude-threads:chat\"] .ct-agent-pill:not(.ct-hidden)",
          "timeoutMs": 15000
        },
        {
          "type": "click",
          "selector": ".workspace-leaf-content[data-type=\"claude-threads:chat\"] .ct-agent-pill",
          "cue": "Sub-agents run in parallel"
        },
        {
          "type": "click",
          "selector": ".ct-agent-row-button",
          "cue": "follow each one"
        },
        {
          "type": "pause",
          "ms": 1800
        }
      ]
    },
    {
      "id": "board",
      "narration": "Every thread, on one board.",
      "actions": [
        {
          "type": "click",
          "selector": ".side-dock-ribbon-action[aria-label=\"Agent Board\"]",
          "cue": "Every thread"
        },
        {
          "type": "waitFor",
          "selector": ".ct-kanban-card",
          "timeoutMs": 10000
        },
        {
          "type": "hover",
          "selector": ".ct-kanban-card-running",
          "cue": "on one board",
          "optional": true
        },
        {
          "type": "pause",
          "ms": 2200
        }
      ]
    }
  ]
}
